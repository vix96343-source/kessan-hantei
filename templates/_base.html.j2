<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% endblock %} | 決算持ち越し判定君</title>
<style>
:root {
  --bg: #171a26; --line: #2a2f42; --head: #e6e9f0; --text: #e6e9f0; --muted: #8b93a7;
  --green: #3ee08f; --red: #ff7a7a; --tab: #1e2232; --panel: #1e2232; --new: #3a3420; --warn: #e6b56a;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 600 16px/1.4 "Meiryo UI", "Yu Gothic UI", "Hiragino Sans", system-ui, sans-serif;
}
nav { display: flex; gap: 4px; align-items: flex-end; padding: 10px 12px 0; max-width: 760px; margin: 0 auto; }
nav a { color: var(--muted); text-decoration: none; padding: 6px 14px; border-radius: 6px 6px 0 0; font-size: 14px; }
nav a[aria-current="page"] { color: var(--text); background: var(--tab); }
.status { margin-left: auto; color: var(--muted); font: 400 12px system-ui, sans-serif; padding-bottom: 6px; white-space: nowrap; }
.status .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); margin-right: 5px; vertical-align: 1px; }
.status .dot.live { background: var(--green); box-shadow: 0 0 6px var(--green); }
main { max-width: 760px; margin: 0 auto; }
table { width: 100%; border-collapse: collapse; table-layout: fixed; font-variant-numeric: tabular-nums; }
th {
  position: sticky; top: 0; background: var(--panel); color: var(--head); font-weight: 600;
  padding: 8px 6px; border-bottom: 1px solid var(--line); font-size: 15px; z-index: 1;
}
td { padding: 9px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-bottom: 1px solid var(--line); }
td a { color: inherit; text-decoration: none; }
.c-time { width: 76px; } .c-code { width: 60px; } .c-kind { width: 104px; } .c-pct { width: 72px; text-align: right; }
th.c-pct { text-align: right; }
tr.up td { color: var(--green); font-weight: 700; }
tr.day td { color: var(--muted); font-size: 13px; padding: 12px 6px 4px; border-bottom: 0; }
.warn { color: var(--warn); }
.none { color: var(--muted); font-weight: 400; }
footer { color: var(--muted); font: 400 12px/1.6 system-ui, sans-serif; padding: 18px 12px 40px; max-width: 760px; margin: 0 auto; }
@media (max-width: 480px) {
  body { font-size: 13px; }
  th { font-size: 12px; }
  .c-time { width: 62px; } .c-code { width: 44px; } .c-kind { width: 70px; } .c-pct { width: 56px; }
  td, th { padding-left: 3px; padding-right: 3px; }
}
{% block style %}{% endblock %}
</style>
</head>
<body>
<nav>
  <a href="index.html"{% if page == "feed" %} aria-current="page"{% endif %}>決算速報</a>
  <a href="calendar.html"{% if page == "calendar" %} aria-current="page"{% endif %}>決算予定</a>
  <span class="status" id="status">{% block status %}{{ generated_at[:16] }} 更新{% endblock %}</span>
</nav>
<main>{% block content %}{% endblock %}</main>
<footer>
  出典: TDnet(日本取引所グループ)/ JPX / Yahoo Finance<br>
  {% block footer %}{% endblock %}
</footer>
{% block script %}{% endblock %}
</body>
</html>
