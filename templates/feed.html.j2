<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TDnet 決算速報</title>
<style>
:root {
  --bg: #12161e; --panel: #1a202c; --row: #1b1e2b; --row2: #20243a; --line: #2a2f42;
  --text: #e6e9f0; --muted: #8b93a7; --teal: #6fd6cb; --teal-bg: #1d4f4c; --teal-line: #3c8e86;
  --warn-bg: #3a2f1f; --warn: #e6b56a; --green: #3ee08f; --red: #ff7a7a; --new: #3a3420;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.45 "Meiryo UI", "Yu Gothic UI", "Hiragino Sans", system-ui, sans-serif; }
header { display: flex; align-items: center; gap: 12px; padding: 8px 14px; border-bottom: 1px solid var(--line); }
header h1 { font-size: 15px; margin: 0; font-weight: 700; }
header .links { margin-left: 8px; font-size: 12px; } header .links a { color: var(--muted); text-decoration: none; }
header .status { margin-left: auto; color: var(--muted); font-size: 12px; white-space: nowrap; }
.dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--muted); margin-right: 6px; vertical-align: 1px; }
.dot.live { background: var(--green); box-shadow: 0 0 6px var(--green); } .dot.err { background: var(--red); }
.bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 14px 6px; }
input, select, button { font: inherit; color: var(--text); background: var(--panel); border: 1px solid var(--line);
  border-radius: 4px; padding: 5px 9px; }
input[type=search] { flex: 1; min-width: 180px; max-width: 320px; }
button { cursor: pointer; }
button.primary { background: var(--teal-bg); border-color: var(--teal-line); color: #dff7f4; }
/* 更新ボタン: 右上に、黒地・細い枠・白い文字だけのシンプルなもの */
button.reload { background: #0d0f14; border: 1px solid #2c313c; border-radius: 6px; color: #fff; padding: 4px 12px;
  font-size: 13px; line-height: 1.4; white-space: nowrap; }
button.reload:hover { border-color: #4a5160; filter: none; }
button.reload:disabled { color: #9aa4b2; cursor: default; }
button:hover { filter: brightness(1.15); }
.bar2 { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 0 14px 8px; font-size: 12px; color: var(--muted); }
.bar2 .sp { flex: 1; }
.bar2 label { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
.bar2 input[type=checkbox] { accent-color: var(--teal); width: 14px; height: 14px; padding: 0; }
.note { margin: 0 14px 8px; padding: 7px 10px; background: var(--warn-bg); color: var(--warn); font-size: 12px; border-radius: 3px; }
.wrap { padding: 0 14px 10px; }
table { border-collapse: collapse; width: 100%; max-width: 900px; font-variant-numeric: tabular-nums; }
th { position: sticky; top: 0; z-index: 1; text-align: left; font-weight: 600; color: var(--text);
  background: var(--panel); padding: 7px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
th .ar { color: var(--muted); font-size: 10px; margin-left: 3px; }
td { padding: 6px 10px; white-space: nowrap; border-bottom: 1px solid #1f2333; }
tbody tr.row td { background: var(--row); }
tbody tr.row.alt td { background: var(--row2); }
tr.row { cursor: pointer; } tr.row:hover td { background: #262b42 !important; }
/* 配色: 文字は落ち着いた灰白、色は「変化」にだけ使う。変化が大きいほど色を濃く(±30%以上は色の帯)。
   プラスは赤、マイナスは水色。背景は暗い青灰色で、行は1行おきにわずかに色を変えて横に追いやすく */
table#list { width: auto; min-width: 520px; font-size: 12px; line-height: 1.3; background: #12161e; }
table#list th { font-size: 12px; font-weight: 400; padding: 2px 8px; text-align: center; color: #7d8696;
  background: #12161e; border: 0; }
table#list td { padding: 2px 8px; font-weight: 400; color: #b4bbc6; background: #12161e !important; border: 0; }
table#list tr.row.alt td { background: #161b25 !important; }
table#list tr.row:hover td { background: #1f2635 !important; }
table#list td.c-date, table#list td.c-time, table#list td.c-code, table#list td.c-name { color: #b4bbc6; }
table#list td.c-kind { color: #7dffa8; }                       /* 種別(決算・業績・配当)は淡い緑 */
table#list td.c-time, table#list td.c-code { text-align: center; }
table#list td.c-kind, table#list th.c-kind { text-align: left; padding-left: 4px; padding-right: 0; }   /* 種別は企業名のすぐ右に左寄せ */
table#list td.c-kind + td.n, table#list th.c-kind + th.n { padding-left: 14px; }   /* 売上の欄を種別に詰める */
table#list td.c-kind .live { color: #9aa4b2; font-size: 11px; margin-left: 4px; }   /* TDnet から直接読んだ速報 */
table#list th.n, table#list th.g { padding-left: 11px; padding-right: 11px; }
table#list td.n, table#list td.g { text-align: right; padding-left: 11px; padding-right: 11px; font-variant-numeric: tabular-nums; }
table#list td.n { color: #b4bbc6; }
table#list td.n.neg { color: #b4bbc6; }                        /* 値のマイナスもほかの数値と同じ色 */
table#list td.g { color: #5c6573; }                            /* 0%・データなし */
table#list td.g.up1, table#list td.g.up2 { color: #7fdcb8; }
table#list tr.row td.g.up3 { color: #7fdcb8; }
table#list td.g.dn1, table#list td.g.dn2 { color: #ff8fa0; }
table#list tr.row td.g.dn3 { color: #ff8fa0; }
/* 種別は枠なしの文字。押すとPDF */
table#list a.pdf { background: none; border: 0; padding: 0; margin: 0 3px; font-size: inherit; font-weight: inherit;
  color: inherit; text-decoration: none; }
table#list a.pdf:hover { text-decoration: underline; }
table#list td.c-date { text-align: center; }
td.c-name { max-width: 8em; overflow: hidden; text-overflow: ellipsis; }   /* 8文字分。長い社名は「…」(マウスを乗せると全部) */
table#list td.c-name, table#list th.c-name { padding-right: 0; }   /* 種別を企業名に詰める */
td.c-pct, th.c-pct { text-align: right; }
td.c-pct.up { color: var(--green); font-weight: 700; } td.c-pct.down { color: var(--muted); }
tr.new td { background: var(--new) !important; }
tr.dayrow td { padding: 22px 6px 6px; background: var(--bg); border: 0; white-space: nowrap; }
tr.dayrow:first-child td { padding-top: 8px; }
tr.dayrow .dd { color: #e4e8ee; font-weight: 700; font-size: 13px; }
tr.dayrow .dn { color: var(--muted); font-size: 12px; margin-left: 10px; }
.badge-new { display: inline-block; font-size: 10px; font-weight: 700; color: #1b1500; background: var(--warn);
  border-radius: 3px; padding: 0 4px; margin-left: 6px; vertical-align: 1px; }
tr.detail td { white-space: normal; background: #0c1220 !important; padding: 8px 12px 12px; }
.dtitle { color: var(--muted); margin-bottom: 8px; }
.dlinks { margin: 2px 0 6px; } .dlinks a { color: var(--teal); margin-right: 16px; }
.finbox { overflow-x: auto; margin: 2px 0 6px; }
table.fin { width: auto; line-height: 1.2; border-collapse: collapse; font-size: 13px;
  font-family: "Consolas", "Menlo", "Meiryo UI", monospace; }
table.fin th { position: static; background: #232a40; color: var(--teal); font-weight: 600; padding: 1px 6px;
  text-align: right; cursor: default; border-bottom: 1px solid var(--line); }
table.fin th:first-child, table.fin td:first-child { text-align: left; }
table.fin td { padding: 0 6px; text-align: right; border-bottom: 1px dotted #262c40; white-space: nowrap; }
table.fin td.neg { color: var(--red); }
/* 行を開いたときの表: 一覧の文字色の指定より優先させる(#list を付ける)。YoY・QoQ はプラス緑・マイナス赤、マイナスの数値も赤 */
#list table.fin td.gup { color: #7fdcb8; } #list table.fin td.gdn { color: #ff8fa0; }
#list table.fin td.neg { color: #ff8fa0; }
#list table.fin td, #list table.fin th { padding-top: 0; padding-bottom: 0; line-height: 1.15; }   /* 行を開いたときの表は縦を詰める */
#list table.fin td, #list table.fin th { padding-left: 10px; padding-right: 10px; }   /* 行を開いたときの表の列の間隔 */
table.fin tr.cur td { background: #21305a; color: #fff; }
table.fin td.lab { color: var(--warn); }
.fincap { color: var(--teal); font-size: 12px; margin: 16px 0 3px; }   /* 表と表の間を少し空ける */
.fincap span { color: var(--muted); margin-left: 8px; }
.segname { color: #c5ccd6; font-size: 12px; margin: 6px 0 1px; }
/* セグメント(単体)・セグメント別業績: 見本の画像と同じ形。プラス緑・マイナス赤、「|」区切り */
.sx-cap, .sx-cap2 { font-size: 13px; margin: 16px 0 2px; font-family: "Consolas", "Menlo", "Meiryo UI", monospace; }
.sx-cap { color: #e6e9ee; } .sx-cap2 { color: var(--teal); }
#list table.sx { width: auto; border-collapse: collapse; font-size: 13px; line-height: 1.3;
  font-family: "Consolas", "Menlo", "Meiryo UI", monospace; }
#list table.sx td { padding: 0 4px; border: 0; white-space: nowrap; text-align: right; color: #e6e9ee; background: none; }
#list table.sx td.h { text-align: left; color: #e6e9ee; }
#list table.sx td.l { text-align: left; color: #e6e9ee; }
#list table.sx td.q { text-align: left; color: #f0b44c; }
#list table.sx td.sep { color: #8a93a6; padding: 0 2px; }
#list table.sx td.p, .sx-yq .p { color: #7fdcb8; } #list table.sx td.m, .sx-yq .m { color: #ff8fa0; }
.sx-yq { font-size: 13px; line-height: 1.35; margin: 4px 0 6px; white-space: nowrap; color: #7fdcb8; font-weight: 600;
  font-family: "Consolas", "Menlo", "Meiryo UI", monospace; }
/* 行を開いたときの中身は3列: 四半期業績(コンセンサス・受注の推移) | セグメント別業績(受注の推移) | セグメント(単体) */
.dcols { display: flex; flex-wrap: nowrap; gap: 6px 24px; align-items: flex-start; overflow-x: auto; }   /* 3列はいつも横並び(狭い画面は横にスクロール) */
#list tr.detail > td { padding-left: 40px; }   /* 行を開いたときの中身の左の余白 */
/* 列の幅は表の幅に合わせる(長い注記は折り返す) */
.dcol { width: min-content; }
.dcol .fincap { white-space: normal; }
.dcol:empty { display: none; }
.dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 4px 18px; font-size: 13px; }
.dl div { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dotted var(--line); padding: 2px 0; }
.dl span:first-child { color: var(--muted); } .dl span:last-child { white-space: nowrap; }
.dl .up { color: var(--green); } .dl .down { color: var(--red); }
td.c-kind { white-space: nowrap; }
a.pdf { display: inline-block; font-size: 11px; line-height: 1.4; padding: 0 5px; margin-right: 4px; border-radius: 3px;
  color: #dff7f4; background: var(--teal-bg); border: 1px solid var(--teal-line); text-decoration: none; }
a.pdf:hover { filter: brightness(1.25); }
a.pdf.sub { background: transparent; color: var(--teal); }
.more { max-width: 900px; padding: 14px 10px; color: var(--muted); text-align: center; font-size: 12px; }
.more button { margin-top: 4px; }
footer { color: var(--muted); font-size: 11px; line-height: 1.6; padding: 4px 14px 30px; max-width: 900px; }
.sm { display: none; }

</style>
</head>
<body>
<header>
  <h1>TDnet 決算速報</h1>
  <span class="links"><a href="calendar.html">決算予定 ›</a></span>
  <span class="status"><span class="dot" id="dot"></span><span id="stamp">–</span></span>
  <button id="reload" class="reload">↻ 更新</button>
</header>

<div class="bar2">
  <span id="count">–</span>
  <span class="sp"></span>
  <label><input type="checkbox" id="onlyNew"> 新着のみ</label>
</div>

<div class="wrap">
<table id="list">
  <thead><tr>
    <th class="c-date" data-k="time">日付</th>
    <th class="c-time" data-k="time">時刻</th>
    <th class="c-code" data-k="code">コード</th>
    <th class="c-name" data-k="name">企業名</th>
    <th class="c-kind" data-k="group">種別</th>
    <th class="n">売上</th><th class="g">YoY</th><th class="g">QoQ</th>
    <th class="n">営利</th><th class="g">YoY</th><th class="g">QoQ</th>
    <th class="n">経利</th><th class="g">YoY</th><th class="g">QoQ</th>
    <th class="n">純利</th><th class="g">YoY</th><th class="g">QoQ</th>
    <th class="n">EPS</th><th class="g">YoY</th><th class="g">QoQ</th>
  </tr></thead>
  <tbody id="tb"></tbody>
</table>
<div class="more" id="more"></div>
</div>
<footer>
  出典: TDnet(日本取引所グループ)・四半期業績と受注の過去分は IRBANK。決算の行: 値とYoYは決算短信1ページ目の連結(期首からの累計・前年同期比)、QoQは3か月(四半期単独)の値どうしの前四半期比。修正の行: 値は修正後の予想、YoYは前期実績比、QoQ欄は前回予想からの修正率。受注高・受注残は行を開くと表示(短信に受注の表がある会社のみ)。前回が赤字のときの増減率は (今回−前回)÷|前回|。決算短信と業績・配当予想の修正を表示。種別のボタンを押すとPDFが開きます(短信=決算短信、資料=決算説明資料・補足資料(短信から14日以内)、修正=業績・配当予想の修正)。平日7:30〜20時は15秒ごとに自動更新(TDnet の新しい開示は5秒ごとに直接確認し「速報」として先に表示)。行をクリック/タップすると数値(売上・営業益の伸び、進捗率、修正率など)が開きます。<br>
</footer>

<script id="index" type="application/json">{{ index_json | safe }}</script>
<script id="day0" type="application/json">{{ day_json | safe }}</script>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const load = (k, d) => { try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
  const save = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
  const wd = d => '日月火水木金土'[new Date(d + 'T00:00:00').getDay()];

  let index = JSON.parse($('index').textContent);
  const days = {};                                     // 読み込み済みの日 -> rows
  const d0 = JSON.parse($('day0').textContent);
  if (d0.date) days[d0.date] = d0.rows;

  const state = { onlyNew: false, sort: 'time:desc' };   // 並びは常に新しい順
  const open = new Set();
  const stored = load('tdnet-seen', null);            // 既読の開示ID(新着判定)
  let firstVisit = stored === null;                   // 初回訪問は全部既読扱い(NEWだらけにしない)
  const seen = new Set(stored || []);
  const fresh = new Set();
  let loading = false;

  // TDnet の監視は平日 7:30〜20時(JST)。新しい開示が無ければデータは更新されないので、監視中かどうかは時間帯で示す
  function setStatus(err) {
    const jst = new Date(Date.now() + 9 * 3600e3), h = jst.getUTCHours(), d = jst.getUTCDay();
    const mins = h * 60 + jst.getUTCMinutes();
    const live = d >= 1 && d <= 5 && mins >= 450 && mins < 1200;   // 7:30〜20:00
    const t = index.generated_at || '';
    const last = t ? `データ ${+t.slice(5, 7)}/${+t.slice(8, 10)} ${t.slice(11, 16)}` : '';
    // 最後にこの画面がサイトを確認した時刻(新しい開示が無くても、確認できていることが分かるように)
    const chk = checkedAt ? ` ・ 確認 ${checkedAt}` : '';
    $('dot').className = 'dot' + (err ? ' err' : live ? ' live' : '');
    $('stamp').textContent = err ? `取得失敗 ・ ${last}` : `${live ? '監視中 ・ ' : ''}${last}${chk}`;
  }

  async function fetchJSON(path) {
    const res = await fetch(path + '?t=' + Date.now(), { cache: 'no-store' });
    if (!res.ok) throw new Error(res.status);
    return res.json();
  }

  function markFresh(rows) {
    if (firstVisit) { rows.forEach(r => seen.add(r.id)); firstVisit = false; }
    for (const r of rows) if (!seen.has(r.id)) { fresh.add(r.id); seen.add(r.id); }
    save('tdnet-seen', [...seen].slice(-5000));
  }

  const loadedDates = () => index.dates.filter(d => days[d]);
  const nextDate = () => index.dates.find(d => !days[d]);   // まだ読んでいない一番新しい日

  async function loadDay(d) {
    const j = await fetchJSON(`data/${d}.json`);
    days[d] = j.rows;
    try { mergeLive(d); } catch (e) {}                  // 速報(TDnet から直接読んだ分)を残す
  }

  function allRows() { return loadedDates().flatMap(d => days[d]); }

  function sorted(rows) {
    const [k, dir] = state.sort.split(':');
    const sgn = dir === 'desc' ? -1 : 1;
    const PER = { '1Q': 1, '2Q': 2, '中間': 2, '3Q': 3, '通期': 4, '期末': 4 };
    const key = r => k === 'time' ? r.date + r.time : k === 'pct' ? (r.pct ?? -1)
      : k === 'period' ? (PER[r.period] ?? 9) : r[k] ?? '';
    return [...rows].sort((a, b) => {
      const x = key(a), y = key(b);
      return (x < y ? -1 : x > y ? 1 : 0) * sgn || (a.date + a.time < b.date + b.time ? 1 : -1);
    });
  }

  function visible() {
    return sorted(allRows().filter(r => !state.onlyNew || fresh.has(r.id)));
  }

  // 決算短信の数値(単独四半期)と YoY・QoQ
  const fmtN = (v, eps) => v == null ? '–' : typeof v === 'string' ? v : eps ? v.toFixed(1) : v.toLocaleString('ja-JP');
  const fmtG = g => g == null ? '–' : typeof g === 'string' ? g
    : (g > 0 ? '+' : '') + (Math.abs(g) >= 1000 ? Math.round(g) : g.toFixed(1)) + '%';
  // YoY・QoQ: プラスは緑、マイナスは赤(セグメントの表と同じ)
  const sign = g => {                                  // 変化の大きさで3段階: 10%未満 / 10〜30% / 30%以上
    if (typeof g !== 'number' || g === 0) return '';
    const a = Math.abs(g);
    return (g > 0 ? ' up' : ' dn') + (a >= 30 ? 3 : a >= 10 ? 2 : 1);
  };
  const neg = v => (typeof v === 'number' && v < 0) || (typeof v === 'string' && v.startsWith('赤')) ? ' neg' : '';
  const blank3 = '<td class="n"></td><td class="g"></td><td class="g"></td>';
  const cells3 = (x, eps) => `<td class="n${neg(x.v)}">${fmtN(x.v, eps)}</td><td class="g${sign(x.yoy)}">${fmtG(x.yoy)}</td><td class="g${sign(x.qoq)}">${fmtG(x.qoq)}</td>`;
  // 受注高は3か月の値。前の四半期の記録が無く累計しか出せないときは「累」を付ける
  const cumMark = x => x && x.cum && x.v != null ? { ...x, v: x.v.toLocaleString('ja-JP') + '累', raw: true } : x;
  function numCells(r) {
    const keys = ['sales', 'op', 'ordinary', 'net', 'eps'];
    const main = r.nums ? keys.map(k => cells3(r.group === '決算' ? cumMark(r.nums[k] || {}) : (r.nums[k] || {}), k === 'eps')).join('') : keys.map(() => blank3).join('');
    return main;
  }

  function pctCell(r) {
    if (r.pct == null) return '<td class="c-pct down">–</td>';
    if (r.up) return `<td class="c-pct up">▲${r.pct}%</td>`;
    return `<td class="c-pct down">${r.pct === 50 ? '' : '▼'}${r.pct}%</td>`;
  }

  function pdfLinks(r) {
    return (r.pdfs || [{ label: 'PDF', url: r.url }]).map(p =>
      `<a class="pdf${p.label === '短信' || p.label === '修正' ? '' : ' sub'}" href="${esc(p.url)}" target="_blank" rel="noopener" title="${esc(p.title || r.title)}">${esc(p.label)}</a>`).join('');
  }

  const num = v => v == null ? '<td>–</td>' : `<td class="${v < 0 ? 'neg' : ''}">${v.toLocaleString('ja-JP')}</td>`;
  const epsCell = v => v == null ? '<td>–</td>' : `<td class="${v < 0 ? 'neg' : ''}">${v.toFixed(1)}</td>`;
  const pct = v => v == null ? '<td>–</td>' : `<td class="${v < 0 ? 'neg' : ''}">${v.toFixed(1)}%</td>`;

  // 行を開いたときの表の YoY・QoQ も一覧と同じ色(プラスは赤、マイナスは水色)
  const gcell = v => v == null ? '<td>–</td>' : `<td class="${v > 0 ? 'gup' : v < 0 ? 'gdn' : ''}">${fmtG(v)}</td>`;
  function orderTable(o) {
    if (!o) return '';
    const segs = o.segments.length ? o.segments : [];
    const line = (name, x, cls) => `<tr class="${cls}"><td>${esc(name)}</td>` + num(x.orders.v).replace('</td>', x.orders.cum ? '累</td>' : '</td>') + gcell(x.orders.yoy) + gcell(x.orders.qoq)
      + num(x.backlog.v) + gcell(x.backlog.yoy) + gcell(x.backlog.qoq) + '</tr>';
    return `<div class="fincap">受注(百万円)<span>受注高は3か月(四半期単独)の値・YoYは前年の同じ四半期比、QoQは前四半期比。受注残は期末残高。「累」は期首からの累計(前の四半期の短信が無いとき)</span></div>
      <div class="finbox"><table class="fin"><tr><th>セグメント</th><th>受注高</th><th>YoY</th><th>QoQ</th><th>受注残</th><th>YoY</th><th>QoQ</th></tr>`
      + segs.map(s => line(s.name, s, '')).join('') + line('合計', o.total, 'cur') + '</table></div>';
  }

  // セグメント別: 受注高・受注残・売上・利益(すべて3か月の値)と YoY・QoQ。合計は一覧と同じ数値
  // セグメント(今回の四半期の単体)・セグメント別業績: 見本の画像と同じ形(「|」区切り・プラス緑・マイナス赤)
  const KANA = 'ァアィイゥウェエォオカガキギクグケゲコゴサザシジスズセゼソゾタダチヂッツヅテデトドナニヌネノハバパヒビピフブプヘベペホボポマミムメモャヤュユョヨラリルレロワヲンヴー・';
  const HANKANA = ['ｧ','ｱ','ｨ','ｲ','ｩ','ｳ','ｪ','ｴ','ｫ','ｵ','ｶ','ｶﾞ','ｷ','ｷﾞ','ｸ','ｸﾞ','ｹ','ｹﾞ','ｺ','ｺﾞ','ｻ','ｻﾞ','ｼ','ｼﾞ','ｽ','ｽﾞ','ｾ','ｾﾞ','ｿ','ｿﾞ',
    'ﾀ','ﾀﾞ','ﾁ','ﾁﾞ','ｯ','ﾂ','ﾂﾞ','ﾃ','ﾃﾞ','ﾄ','ﾄﾞ','ﾅ','ﾆ','ﾇ','ﾈ','ﾉ','ﾊ','ﾊﾞ','ﾊﾟ','ﾋ','ﾋﾞ','ﾋﾟ','ﾌ','ﾌﾞ','ﾌﾟ','ﾍ','ﾍﾞ','ﾍﾟ','ﾎ','ﾎﾞ','ﾎﾟ',
    'ﾏ','ﾐ','ﾑ','ﾒ','ﾓ','ｬ','ﾔ','ｭ','ﾕ','ｮ','ﾖ','ﾗ','ﾘ','ﾙ','ﾚ','ﾛ','ﾜ','ｦ','ﾝ','ｳﾞ','ｰ','･'];
  const width = t => [...t].reduce((n, c) => n + (/[ -~｡-ﾟ]/.test(c) ? 1 : 2), 0);
  const cut = (t, w) => { let o = ''; for (const c of t) { if (width(o + c) > w) break; o += c; } return o; };
  // セグメント別業績の列の名前: 「事業」を外して半角カナに(全角13文字分まで)
  const shortName = n => cut([...n.replace(/事業$/, '')].map(c => { const k = KANA.indexOf(c); return k < 0 ? c : HANKANA[k]; }).join(''), 13);
  const pctG = v => v == null ? '-' : `<span class="${v > 0 ? 'p' : v < 0 ? 'm' : ''}">${fmtG(v)}</span>`;
  const segList = g => ((g && g.hist) || []).filter(h => !h.total && h.rows.length);
  const v0 = x => x == null ? '-' : x.toLocaleString('ja-JP');

  // g がセグメント、または品目別などの内訳(name: 表の名前。内訳は利益が無いので売上だけ)
  function segQuarter(g, name) {
    const list = segList(g);
    if (!list.length) return '';
    const end = list.map(h => h.rows[h.rows.length - 1].end).sort().pop();
    const lastRow = list.map(h => h.rows[h.rows.length - 1]).find(x => x.end === end);
    const q = lastRow.q, kind = lastRow.cum ? '累計' : '単体';        // 3か月にできないときは累計(品目別などの内訳)
    const cur = h => h.rows.find(x => x.end === end) || {};
    const val = (h, f) => { const x = cur(h)[f]; return v0(x ? x.v : null); };
    const hasOp = list.some(h => h.rows.some(x => x.op && x.op.v != null));
    return `<div class="sx-cap">${esc(name || 'セグメント')}（${q}Q${kind}）:</div><table class="sx sx1"><tr><td></td>`
      + list.map((h, i) => `<td class="h">${esc(cut(h.name, 16))}</td>${i < list.length - 1 ? '<td class="sep">|</td>' : ''}`).join('') + '</tr>'
      + (hasOp ? ['sales', 'op'] : ['sales']).map(f => `<tr><td class="l">${f === 'sales' ? '売上' : '利益'}</td>`
        + list.map((h, i) => `<td class="n">${val(h, f)}</td>${i < list.length - 1 ? '<td class="sep">|</td>' : ''}`).join('') + '</tr>').join('')
      + '</table><div class="sx-yq">' + list.map(h => { const x = cur(h);
        return `<div><span class="nm">${esc(cut(h.name, 16))}:</span> 売YY${pctG(x.sales && x.sales.yoy)} QQ${pctG(x.sales && x.sales.qoq)}`
          + (hasOp ? ` 利益YY${pctG(x.op && x.op.yoy)} QQ${pctG(x.op && x.op.qoq)}` : '') + '</div>'; }).join('') + '</div>';
  }

  function segMatrix(g, name) {
    const list = segList(g);
    if (!list.length) return '';
    const ends = [...new Set(list.flatMap(h => h.rows.map(x => x.end)))].sort().slice(-5);    // 1年前(前年の同じ四半期)から今回まで(古い順)
    const at = (h, e) => h.rows.find(x => x.end === e);
    const last = ends[ends.length - 1];
    const sorted = list;                                 // 短信のセグメント情報と同じ順番
    const qOf = e => (list.map(h => at(h, e)).find(x => x) || {}).q;
    const cumOf = e => (list.map(h => at(h, e)).find(x => x) || {}).cum;
    const lab = e => `${e.slice(2, 4)}/${+e.slice(5, 7)}${qOf(e)}Q${cumOf(e) ? '累計' : ''}`;
    const cell = (h, e, f) => { const x = at(h, e); const v = x && x[f] ? x[f].v : null;
      return `<td class="n${f === 'op' && v != null ? (v > 0 ? ' p' : v < 0 ? ' m' : '') : ''}">${v0(v)}</td>`; };
    const hasOp = list.some(h => h.rows.some(x => x.op && x.op.v != null));
    return `<div class="sx-cap2">【${esc(name || 'セグメント別業績')}】</div><table class="sx sx2"><tr><td></td><td></td>`
      + sorted.map(h => `<td class="h">| ${esc(shortName(h.name))}</td>`).join('') + '</tr>'
      + ends.map(e => `<tr><td class="q">${esc(lab(e))}</td><td class="l">売上</td>` + sorted.map(h => cell(h, e, 'sales')).join('') + '</tr>'
        + (hasOp ? '<tr><td></td><td class="l">利益</td>' + sorted.map(h => cell(h, e, 'op')).join('') + '</tr>' : '')).join('')
      + '</table>';
  }

  // アナリスト予想の平均(四半期2つと今期・来期の通期)
  function consTable(c) {
    if (!c) return '';
    return `<div class="fincap">【コンセンサス】(百万円)<span>${c.next_fy ? '来期=' + esc(c.next_fy) + '・' : ''}${esc(c.date)} 時点${c.before ? '(発表前)' : '(発表後)'}・アナリスト ${c.n ?? '–'}人・四半期は3か月の値・EPSは円</span></div>
      <div class="finbox"><table class="fin"><tr><th></th>${c.cols.map(h => `<th>${esc(h)}</th>`).join('')}</tr>`
      + c.rows.map(r => `<tr><td class="lab">${esc(r.label)}</td>` + r.vals.map(v => r.label === 'EPS' ? epsCell(v) : num(v)).join('') + '</tr>').join('')
      + '</table></div>';
  }

  // 受注の推移(期間・受注高(累計)・YoY・単体Q・QoQ・QYoY・受注残・残YoY)
  // 受注の推移: 全社とセグメント(品目)ごとを1つにまとめ、同じ列(期間・受注高(累計)・YoY・単体Q・QoQ・QYoY・受注残・残YoY)で
  function orderHistory(o) {
    const head = '<tr><th>期間</th><th>受注高</th><th>YoY</th><th>単体Q</th><th>QoQ</th><th>QYoY</th><th>受注残</th><th>残YoY</th></tr>';
    const table = rows => '<div class="finbox"><table class="fin">' + head
      + rows.map((x, i) => `<tr class="${i === rows.length - 1 ? 'cur' : ''}"><td>${esc(x.label)}</td>` + num(x.cum) + gcell(x.yoy)
        + num(x.q) + gcell(x.qoq) + gcell(x.qyoy) + num(x.backlog) + gcell(x.byoy) + '</tr>').join('') + '</table></div>';
    const has = rows => rows && rows.some(x => x.cum != null || x.q != null || x.backlog != null);
    const total = o && o.hist && o.hist.length && has(o.hist) ? o.hist : null;
    const segs = ((o && o.seg_hist) || []).filter(g => has(g.rows));
    if (!total && !segs.length) return '';
    return `<div class="fincap">受注の推移(百万円)<span>受注高は期首からの累計、単体Qは3か月の値、QYoYは単体Qの前年同期比、受注残は期末残高</span></div>`
      + (total ? (segs.length ? '<div class="segname">全社</div>' : '') + table(total) : '')
      + segs.map(g => `<div class="segname">${g.parent ? '└ ' : ''}${esc(g.name)}</div>` + table(g.rows)).join('');
  }


  // 業績予想の修正の中身: 期(中間期・通期など)ごとに 前回予想・今回予想・増減率・前期実績
  function revTable(rv) {
    if (!rv || !rv.length) return '';
    const head = '<tr><th></th><th>売上高</th><th>営業益</th><th>経常益</th><th>最終益</th><th>EPS</th></tr>';
    const line = (lab, vals, cls) => `<tr class="${cls || ''}"><td class="lab">${lab}</td>` + vals.map((v, i) => i === 4 ? epsCell(v) : num(v)).join('') + '</tr>';
    const pct = (lab, vals) => `<tr><td class="lab">${lab}</td>` + vals.map(v => gcell(v)).join('') + '</tr>';
    return `<div class="fincap">業績予想の修正(百万円)<span>EPSは円。一覧には修正率の大きい期を表示</span></div>`
      + rv.map(p => `<div class="segname">${esc(p.period)}${p.main ? '(一覧に表示)' : ''}</div><div class="finbox"><table class="fin">${head}`
        + line('前回予想', p.prev) + line('今回予想', p.cur, 'cur') + pct('増減率', p.chg) + line('前期実績', p.prior) + pct('前期比', p.yoy)
        + '</table></div>').join('');
  }

  function finTables(f) {
    if (!f) return '';
    let h = '';
    if (f.quarters && f.quarters.length) {
      h += `<div class="fincap">四半期業績(単独・百万円)<span>EPSは円(直近の短信の株数で換算)</span></div><div class="finbox"><table class="fin qtab">
        <tr><th>決算期</th><th>売上高</th><th>営業益</th><th>経常益</th><th>最終益</th><th>EPS</th></tr>`
        + f.quarters.map((q, i) => `<tr class="${i === f.quarters.length - 1 ? 'cur' : ''}"><td>${esc(q.label)}</td>`
          + num(q.sales) + num(q.op) + num(q.ordinary) + num(q.net) + epsCell(q.eps) + '</tr>').join('')
        + '</table></div>';
    }
    return h;
  }

  function detail(r) {
    return `<tr class="detail"><td colspan="20">
      <div class="dtitle">${esc(r.title)}</div>
      <div class="dlinks">${(r.pdfs || []).map(p => `<a href="${esc(p.url)}" target="_blank" rel="noopener" title="${esc(p.title || '')}">${esc(p.label === '資料' || p.label === '資料2' ? '説明資料' : p.label === '短信' ? '決算短信' : '修正の開示')}(PDF)</a>`).join('')}<a href="https://kabuyoho.jp/report?bcode=${encodeURIComponent(r.code)}" target="_blank" rel="noopener">株予報(コンセンサス)</a></div>
      <div class="dcols"><div class="dcol">${revTable(r.rev)}${finTables(r.fin)}${consTable(r.cons)}${orderHistory(r.ord)}</div>
      ${[segMatrix(r.seg) + segMatrix(r.brk, r.brk && r.brk.title), segQuarter(r.seg) + segQuarter(r.brk, r.brk && r.brk.title)]
        .filter(h => h).map(h => `<div class="dcol">${h}</div>`).join('')}</div>
    </td></tr>`;
  }

  function render() {
    const rows = visible();
    const total = (index.days || []).reduce((s, x) => s + x.n, 0) || allRows().length;
    $('count').textContent = `${rows.length}件 / 決算・修正 ${total}件`;
    const byTime = true;
    let html = '', day = null;
    rows.forEach((r, i) => {
      if (byTime && r.date !== day) {
        const c = (index.days || []).find(x => x.date === r.date);
        html += `<tr class="dayrow"><td colspan="20"><span class="dd">${r.date.replace(/-/g, '/')}(${wd(r.date)})</span>`
              + (c ? `<span class="dn">決算 ${c.earn}件 ・ 修正 ${c.rev}件</span>` : '') + '</td></tr>';
        day = r.date;
      }
      const isNew = fresh.has(r.id);
      html += `<tr class="row${i % 2 ? ' alt' : ''}${r.group === '修正' ? ' rev' : ''}${isNew ? ' new' : ''}" data-id="${esc(r.id)}">
        <td class="c-date">${r.date.slice(5).replace('-', '/')}</td><td class="c-time">T${esc(r.time)}</td>
        <td class="c-code">${esc(r.code)}</td>
        <td class="c-name" title="${esc(r.name)} ${esc(r.title)}">${esc(r.name)}${isNew ? '<span class="badge-new">NEW</span>' : ''}</td>
        <td class="c-kind"><a class="pdf" href="${esc(r.url)}" target="_blank" rel="noopener" title="${esc(r.title)}">${esc(r.label || r.group).replace(' ', '<br>')}</a>${r.live ? '<span class="live">速報</span>' : ''}</td>${numCells(r)}</tr>`;
      if (open.has(r.id)) html += detail(r);
    });
    $('tb').innerHTML = html || `<tr><td colspan="20" class="more">${state.onlyNew ? '新着はありません' : '該当する開示はありません'}</td></tr>`;

    const nd = nextDate();
    $('more').innerHTML = nd
      ? `${loading ? '読み込み中…' : `スクロールで ${+nd.slice(5, 7)}/${+nd.slice(8, 10)} 以前を表示`}<br><button id="moreBtn">さらに表示</button>`
      : (index.dates.length ? `${index.dates[index.dates.length - 1].replace(/-/g, '/')} 以降をすべて表示しています` : '');
  }

  async function loadMore(n = 1) {
    if (loading) return;
    loading = true; render();
    try {
      for (let i = 0; i < n; i++) { const d = nextDate(); if (!d) break; await loadDay(d); }
    } catch (e) { setStatus(true); }
    loading = false; render();
  }


  // ---- TDnet を直接読む(Cloudflare の中継経由)。サイトのデータに載る前の新しい開示を「速報」として先に出す ----
  const PROXY = {{ proxy | tojson }};
  const TDNET = 'https://www.release.tdnet.info/inbs/';
  const FUNDS = new Set({{ funds | tojson }});         // ETF・ETN・REIT 等(サイトのデータと同じく取り込まない)
  const live = new Map();                              // id -> 速報の行(サイトのデータに載ったら消す)
  const LABEL = { earnings_report: '決算', forecast_revision: '業績', dividend_revision: '配当', forecast_dividend_revision: '業績 配当' };
  // 表題からの種別の判定(src/datasources/tdnet.py の classify_title と同じ考え方)
  const RE = {
    corr: /^[\s(（【]*訂正|^[\s]*[(（【][^)）】]*訂正[^)）】]*[)）】]|一部訂正|訂正版|データ訂正/,
    fund: /上場投信|上場投資信託|連動型|ＥＴＦ|ETF|ＥＴＮ|ETN|指数連動|ＲＥＩＴ|REIT|インフラファンド/,
    fc: /業績予想|業績見通し|業績予測/, dv: /配当予想|配当の予想|増配|減配|無配|記念配当|特別配当/, rv: /修正|上方|下方|増配|減配|無配/,
  };
  function kindOf(t) {
    if (RE.corr.test(t) || RE.fund.test(t)) return null;
    if (/決算短信/.test(t)) {
      if (/(お知らせ|について|延期|遅延)\s*$/.test(t) && !/補足|説明資料/.test(t)) return null;
      return /補足|説明|参考資料|概要/.test(t) ? null : 'earnings_report';
    }
    const fc = RE.fc.test(t), dv = RE.dv.test(t), rv = RE.rv.test(t);
    return fc && dv && rv ? 'forecast_dividend_revision' : fc && rv ? 'forecast_revision' : dv && rv ? 'dividend_revision' : null;
  }
  const jstToday = () => new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
  function mergeLive(d) {
    const rows = (days[d] || []).filter(r => !r.live);
    const ids = new Set(rows.map(r => r.id));
    for (const id of [...live.keys()]) if (ids.has(id)) live.delete(id);   // サイトのデータに載ったら速報は消す
    const add = [...live.values()].filter(r => r.date === d);
    if (!add.length && !days[d]) return;
    days[d] = [...add, ...rows];
    if (!index.dates.includes(d)) index.dates.unshift(d);
  }
  // all=false は1ページ目だけ(新しい開示は1ページ目の上に出る)。自動の確認はこちらで軽く速く
  async function fetchLive(all = true) {
    if (!PROXY) return 0;
    const d = jstToday(), ymd = d.replace(/-/g, '');
    const page = async n => {
      const res = await fetch(`${PROXY}/list/${ymd}/${String(n).padStart(3, '0')}`, { cache: 'no-store' });
      return res.ok ? new DOMParser().parseFromString(await res.text(), 'text/html') : null;
    };
    const first = await page(1);
    if (!first) return 0;
    const before = live.size;
    const total = +((first.querySelector('.kaijiSum')?.textContent.match(/全\s*(\d+)\s*件/) || [])[1] || 0);
    const docs = [first];
    if (all) for (let n = 2; n <= Math.min(Math.ceil(total / 100), 10); n++) { const doc = await page(n); if (doc) docs.push(doc); }
    const have = new Set((days[d] || []).filter(r => !r.live).map(r => r.id));
    for (const doc of docs) for (const tr of doc.querySelectorAll('#main-list-table tr')) {
      const c = cls => tr.querySelector('td.' + cls);
      const a = c('kjTitle')?.querySelector('a');
      if (!a || !c('kjTime') || !c('kjCode')) continue;
      const title = a.textContent.trim(), kind = kindOf(title);
      if (!kind) continue;
      const href = a.getAttribute('href'), id = href.replace(/\.pdf$/, '');
      if (have.has(id) || live.has(id)) continue;
      const raw = c('kjCode').textContent.trim(), code = raw.length === 5 && raw.endsWith('0') ? raw.slice(0, 4) : raw;
      if (FUNDS.has(code)) continue;
      const earn = kind === 'earnings_report';
      live.set(id, { id, date: d, time: c('kjTime').textContent.trim(), code, live: true,
        name: (c('kjName')?.textContent.trim() || '').normalize('NFKC').replace(/^[GPQAFSN]-/, ''),   // 市場の印(G-等)を外す(src/site.py の company_name と同じ)
        group: earn ? '決算' : '修正', label: LABEL[kind],
        period: '', url: TDNET + href, title, nums: null,
        pdfs: [{ label: earn ? '短信' : '修正', url: TDNET + href, title }] });
    }
    mergeLive(d);
    return live.size - before;
  }
  // 5秒ごとに TDnet の1ページ目を直接見て、新しい開示があればすぐ出す(画面を見ていない間は休止)
  let liveBusy = false;
  async function liveTick() {
    if (!PROXY || document.hidden || liveBusy) return;
    liveBusy = true;
    try {
      if (await fetchLive(false) > 0) { const t = jstToday(); if (days[t]) markFresh(days[t]); render(); }
    } catch (e) { /* 次の回で取り直す */ }
    liveBusy = false;
  }
  setInterval(liveTick, 5000);


  let checkedAt = '';
  const hms = () => new Date(Date.now() + 9 * 3600e3).toISOString().slice(11, 19);
  async function refresh(manual) {
    if (document.hidden && !manual) return;              // 非表示の間は休止
    const btn = $('reload');
    if (manual) { btn.disabled = true; btn.textContent = '↻ 確認中…'; }
    const before = allRows().length;
    try {
      const idx = await fetchJSON('data/index.json');
      // 画面の作りが更新されていたら新しい版に読み直す(URLを変えてブラウザのキャッシュを避ける)
      if (idx.build && index.build && idx.build !== index.build) {
        location.replace(location.pathname + '?v=' + idx.build + location.hash);
        return;
      }
      const changed = idx.generated_at !== index.generated_at;
      index = idx;
      if (changed || manual) {
        // 最新日だけ取り直す(過去の日は変わらない)
        const latest = index.dates[0];
        if (latest) { await loadDay(latest); markFresh(days[latest]); }
      }
      // TDnet を直接見て、サイトのデータにまだ無い開示を「速報」として足す(中継が止まっていても一覧は出す)
      // 更新ボタンのときは全ページ、自動のときは1ページ目だけ
      try { await fetchLive(!!manual); const t = jstToday(); if (days[t]) markFresh(days[t]); } catch (e) { console.warn('TDnet 直接取得に失敗', e); }
      checkedAt = hms();
      setStatus(false);
      render();
      if (manual) {
        const added = allRows().length - before;
        btn.textContent = added > 0 ? `↻ ${added}件追加` : '↻ 最新です';
      }
    } catch (e) {
      setStatus(true);
      if (manual) btn.textContent = '↻ 取得失敗';
    }
    if (manual) setTimeout(() => { btn.disabled = false; btn.textContent = '↻ 更新'; }, 2000);
  }


  $('onlyNew').addEventListener('change', e => { state.onlyNew = e.target.checked; render(); });
  $('reload').addEventListener('click', () => refresh(true));
  $('more').addEventListener('click', e => { if (e.target.id === 'moreBtn') loadMore(); });
  $('tb').addEventListener('click', e => {
    if (e.target.closest('a')) return;
    const tr = e.target.closest('tr.row'); if (!tr) return;
    const id = tr.dataset.id;
    open.has(id) ? open.delete(id) : open.add(id);
    fresh.delete(id);
    render();
  });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  setInterval(refresh, 15000);                         // 15秒ごとに確認(非表示の間は休止)

  // 一番下に近づいたら前の日を読み足す(無限スクロール)
  const nearBottom = () => $('more').getBoundingClientRect().top < innerHeight + 600;
  async function autoMore() {
    while (!loading && nextDate() && nearBottom()) await loadMore();
  }
  let scrollTimer = null;
  addEventListener('scroll', () => { clearTimeout(scrollTimer); scrollTimer = setTimeout(autoMore, 100); }, { passive: true });
  addEventListener('resize', () => autoMore());

  if (d0.date) markFresh(d0.rows);
  setStatus(false);
  render();
  loadMore(2).then(autoMore);                          // 最初は直近3日ぶんを用意
})();
</script>
</body>
</html>
