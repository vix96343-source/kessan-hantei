<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>TDnet 決算速報</title>
<style>
:root {
  --bg: #171a26; --panel: #1e2232; --row: #1b1e2b; --row2: #20243a; --line: #2a2f42;
  --text: #e6e9f0; --muted: #8b93a7; --teal: #6fd6cb; --teal-bg: #1d4f4c; --teal-line: #3c8e86;
  --warn-bg: #3a2f1f; --warn: #e6b56a; --green: #3ee08f; --red: #ff7a7a; --new: #3a3420;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.45 "Meiryo UI", "Yu Gothic UI", "Hiragino Sans", system-ui, sans-serif; }
header { display: flex; align-items: center; gap: 12px; padding: 8px 14px; border-bottom: 1px solid var(--line); }
header h1 { font-size: 15px; margin: 0; font-weight: 700; }
header .links { margin-left: 8px; font-size: 12px; } header .links a { color: var(--muted); text-decoration: none; }
header .status { margin-left: auto; color: var(--muted); font-size: 12px; white-space: nowrap; }
.dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--muted); margin-right: 6px; vertical-align: 1px; }
.dot.live { background: var(--green); box-shadow: 0 0 6px var(--green); } .dot.err { background: var(--red); }
.bar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 14px 6px; }
input, select, button { font: inherit; color: var(--text); background: var(--panel); border: 1px solid var(--line);
  border-radius: 4px; padding: 5px 9px; }
input[type=search] { flex: 1; min-width: 180px; max-width: 320px; }
button { cursor: pointer; }
button.primary { background: var(--teal-bg); border-color: var(--teal-line); color: #dff7f4; }
button:hover { filter: brightness(1.15); }
.bar2 { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; padding: 0 14px 8px; font-size: 12px; color: var(--muted); }
.bar2 .sp { flex: 1; }
.bar2 label { display: inline-flex; align-items: center; gap: 5px; cursor: pointer; }
.bar2 input[type=checkbox] { accent-color: var(--teal); width: 14px; height: 14px; padding: 0; }
.note { margin: 0 14px 8px; padding: 7px 10px; background: var(--warn-bg); color: var(--warn); font-size: 12px; border-radius: 3px; }
.wrap { padding: 0 14px 10px; }
table { border-collapse: collapse; width: 100%; max-width: 900px; font-variant-numeric: tabular-nums; }
th { position: sticky; top: 0; z-index: 1; text-align: left; font-weight: 600; color: var(--text);
  background: var(--panel); padding: 7px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
th .ar { color: var(--muted); font-size: 10px; margin-left: 3px; }
td { padding: 6px 10px; white-space: nowrap; border-bottom: 1px solid #1f2333; }
tbody tr.row td { background: var(--row); }
tbody tr.row.alt td { background: var(--row2); }
tr.row { cursor: pointer; } tr.row:hover td { background: #262b42 !important; }
/* お手本と同じ見た目: 濃紺の背景、▲の行は明るい緑の太字、▼の行は白っぽい灰色の普通の太さ */
table#list { width: auto; min-width: 520px; max-width: 900px; font-size: 12px; line-height: 1.3; background: #161b2a; }
table#list th { font-size: 12px; font-weight: 400; padding: 2px 12px; text-align: center; color: #8d97aa;
  background: #161b2a; border-bottom: 1px solid #2a3147; }
table#list td { padding: 2px 12px; font-weight: 400; color: #c3c8d4; background: #181d2d !important;
  border-bottom: 1px solid #222839; }
table#list tr.row.alt td { background: #1b2133 !important; }
table#list tr.row.up td { color: #2ee87b; font-weight: 700; }
table#list td.c-time, table#list td.c-code, table#list td.c-kind, table#list td.c-per { text-align: center; }
table#list td.c-pct { text-align: right; }
table#list td.c-pct.down { color: #c3c8d4; font-weight: 400; }
table#list tr.row.up td.c-pct { color: #2ee87b; font-weight: 700; }
/* 種別は枠なしの文字(行と同じ色)。押すとPDF */
table#list a.pdf { background: none; border: 0; padding: 0; margin: 0 3px; font-size: inherit; font-weight: inherit;
  color: inherit; text-decoration: none; }
table#list a.pdf:hover { text-decoration: underline; }
table#list tr.row:hover td { background: #232a40 !important; }
table#list td.c-date { text-align: center; }
td.c-per { color: var(--text); }
td.c-name { max-width: 260px; overflow: hidden; text-overflow: ellipsis; }
td.c-pct, th.c-pct { text-align: right; }
td.c-pct.up { color: var(--green); font-weight: 700; } td.c-pct.down { color: var(--muted); }
tr.new td { background: var(--new) !important; }
tr.dayrow td { padding: 22px 6px 6px; background: var(--bg); border-bottom: 1px solid var(--line); white-space: nowrap; }
tr.dayrow:first-child td { padding-top: 8px; }
tr.dayrow .dd { color: var(--text); font-weight: 700; font-size: 14px; }
tr.dayrow .dn { color: var(--muted); font-size: 12px; margin-left: 10px; }
.datebox { display: inline-flex; align-items: center; gap: 4px; }
.datebox input[type=date] { color-scheme: dark; }
.datebox button { padding: 5px 8px; }
.badge-new { display: inline-block; font-size: 10px; font-weight: 700; color: #1b1500; background: var(--warn);
  border-radius: 3px; padding: 0 4px; margin-left: 6px; vertical-align: 1px; }
tr.detail td { white-space: normal; background: #141724 !important; padding: 8px 12px 12px; }
.dtitle { color: var(--muted); margin-bottom: 8px; }
.dlinks { margin: 2px 0 6px; } .dlinks a { color: var(--teal); margin-right: 16px; }
.finbox { overflow-x: auto; margin: 4px 0 10px; }
table.fin { width: auto; min-width: 520px; max-width: 760px; border-collapse: collapse; font-size: 12.5px;
  font-family: "Consolas", "Menlo", "Meiryo UI", monospace; }
table.fin th { position: static; background: #232a40; color: var(--teal); font-weight: 600; padding: 3px 10px;
  text-align: right; cursor: default; border-bottom: 1px solid var(--line); }
table.fin th:first-child, table.fin td:first-child { text-align: left; }
table.fin td { padding: 2px 10px; text-align: right; border-bottom: 1px dotted #262c40; white-space: nowrap; }
table.fin td.neg { color: var(--red); }
table.fin tr.cur td { background: #21305a; color: #fff; }
table.fin td.lab { color: var(--warn); }
.fincap { color: var(--teal); font-size: 12px; margin: 10px 0 3px; }
.fincap span { color: var(--muted); margin-left: 8px; }
.dl { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 4px 18px; font-size: 13px; }
.dl div { display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px dotted var(--line); padding: 2px 0; }
.dl span:first-child { color: var(--muted); } .dl span:last-child { white-space: nowrap; }
.dl .up { color: var(--green); } .dl .down { color: var(--red); }
td.c-kind { white-space: nowrap; }
a.pdf { display: inline-block; font-size: 11px; line-height: 1.4; padding: 0 5px; margin-right: 4px; border-radius: 3px;
  color: #dff7f4; background: var(--teal-bg); border: 1px solid var(--teal-line); text-decoration: none; }
a.pdf:hover { filter: brightness(1.25); }
a.pdf.sub { background: transparent; color: var(--teal); }
.more { max-width: 900px; padding: 14px 10px; color: var(--muted); text-align: center; font-size: 12px; }
.more button { margin-top: 4px; }
footer { color: var(--muted); font-size: 11px; line-height: 1.6; padding: 4px 14px 30px; max-width: 900px; }
.sm { display: none; }

</style>
</head>
<body>
<header>
  <h1>TDnet 決算速報</h1>
  <span class="links"><a href="calendar.html">決算予定 ›</a></span>
  <span class="status"><span class="dot" id="dot"></span><span id="stamp">–</span></span>
</header>

<div class="bar">
  <span class="datebox"><input type="date" id="dayq" aria-label="日付で絞り込み" title="日付で絞り込み"><button id="dayclr" title="日付の絞り込みを解除" hidden>×</button></span>
  <input type="search" id="q" placeholder="コード・会社名・表題・日付(10/8)で検索" aria-label="検索">
  <button class="primary" id="reload">↻ 更新</button>
</div>
<div class="bar2">
  <span id="count">–</span>
  <span class="sp"></span>
  <label><input type="checkbox" id="onlyNew"> 新着のみ</label>
</div>

<div class="wrap">
<table id="list">
  <thead><tr>
    <th class="c-date" data-k="time">日付</th>
    <th class="c-time" data-k="time">時刻</th>
    <th class="c-code" data-k="code">コード</th>
    <th class="c-name" data-k="name">企業名</th>
    <th class="c-kind" data-k="group">種別</th>
    <th class="c-per" data-k="period">期</th>
    <th class="c-pct" data-k="pct"><span class="lg">上昇確度</span><span class="sm">確度</span></th>
  </tr></thead>
  <tbody id="tb"></tbody>
</table>
<div class="more" id="more"></div>
</div>
<footer>
  出典: TDnet(日本取引所グループ)・四半期業績の過去分は IRBANK。決算短信と業績・配当予想の修正を表示。種別のボタンを押すとPDFが開きます(短信=決算短信、資料=決算説明資料・補足資料(短信から14日以内)、修正=業績・配当予想の修正)。平日8〜20時は1分ごとに自動更新。行をクリック/タップすると数値(売上・営業益の伸び、進捗率、修正率など)が開きます。<br>
  期: 決算は 1Q/2Q/3Q/通期、修正は対象の期間(通期/中間)。<br>
  上昇確度 = 似た開示(決算は「上がりやすい決算内容」の3つの型 ①リクルート ②キオクシア ③ローツェB に当てはまった数、修正は方向と幅)が過去に「開示前終値→開示後最初の終値」で上昇した割合。当てはまった型は行を開くと表示されます。
</footer>

<script id="index" type="application/json">{{ index_json | safe }}</script>
<script id="day0" type="application/json">{{ day_json | safe }}</script>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const load = (k, d) => { try { const v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } };
  const save = (k, v) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
  const wd = d => '日月火水木金土'[new Date(d + 'T00:00:00').getDay()];

  let index = JSON.parse($('index').textContent);
  const days = {};                                     // 読み込み済みの日 -> rows
  const d0 = JSON.parse($('day0').textContent);
  if (d0.date) days[d0.date] = d0.rows;

  const state = { q: '', day: '', onlyNew: false, sort: 'time:desc' };   // 並びは常に新しい順
  const open = new Set();
  const stored = load('tdnet-seen', null);            // 既読の開示ID(新着判定)
  let firstVisit = stored === null;                   // 初回訪問は全部既読扱い(NEWだらけにしない)
  const seen = new Set(stored || []);
  const fresh = new Set();
  let loading = false;
  if (index.dates.length) { $('dayq').min = index.dates[index.dates.length - 1]; $('dayq').max = index.dates[0]; }

  // TDnet の監視は平日 8〜20時(JST)。新しい開示が無ければデータは更新されないので、監視中かどうかは時間帯で示す
  function setStatus(err) {
    const jst = new Date(Date.now() + 9 * 3600e3), h = jst.getUTCHours(), d = jst.getUTCDay();
    const live = d >= 1 && d <= 5 && h >= 8 && h < 20;
    const t = index.generated_at || '';
    const last = t ? `最終 ${+t.slice(5, 7)}/${+t.slice(8, 10)} ${t.slice(11, 16)}` : '';
    $('dot').className = 'dot' + (err ? ' err' : live ? ' live' : '');
    $('stamp').textContent = err ? `取得失敗 ・ ${last}` : `${live ? '監視中 ・ ' : ''}${last}`;
  }

  async function fetchJSON(path) {
    const res = await fetch(path + '?t=' + Date.now(), { cache: 'no-store' });
    if (!res.ok) throw new Error(res.status);
    return res.json();
  }

  function markFresh(rows) {
    if (firstVisit) { rows.forEach(r => seen.add(r.id)); firstVisit = false; }
    for (const r of rows) if (!seen.has(r.id)) { fresh.add(r.id); seen.add(r.id); }
    save('tdnet-seen', [...seen].slice(-5000));
  }

  const loadedDates = () => index.dates.filter(d => days[d]);
  const nextDate = () => index.dates.find(d => !days[d]);   // まだ読んでいない一番新しい日

  async function loadDay(d) {
    const j = await fetchJSON(`data/${d}.json`);
    days[d] = j.rows;
  }

  function allRows() { return loadedDates().flatMap(d => days[d]); }

  function sorted(rows) {
    const [k, dir] = state.sort.split(':');
    const sgn = dir === 'desc' ? -1 : 1;
    const PER = { '1Q': 1, '2Q': 2, '中間': 2, '3Q': 3, '通期': 4, '期末': 4 };
    const key = r => k === 'time' ? r.date + r.time : k === 'pct' ? (r.pct ?? -1)
      : k === 'period' ? (PER[r.period] ?? 9) : r[k] ?? '';
    return [...rows].sort((a, b) => {
      const x = key(a), y = key(b);
      return (x < y ? -1 : x > y ? 1 : 0) * sgn || (a.date + a.time < b.date + b.time ? 1 : -1);
    });
  }

  // 「10/8」「2026/10/08」「2026-10-08」「10月8日」を日付として解釈する
  function parseDateQuery(q) {
    const m = q.trim().match(/^(?:(\d{4})[\/\-年])?(\d{1,2})[\/\-月](\d{1,2})日?$/);
    if (!m) return null;
    return { y: m[1] || null, md: `${m[2].padStart(2, '0')}-${m[3].padStart(2, '0')}` };
  }

  function visible() {
    const q = state.q.trim().toLowerCase();
    const dq = parseDateQuery(q);
    return sorted(allRows().filter(r =>
      (!state.day || r.date === state.day) &&
      (!state.onlyNew || fresh.has(r.id)) &&
      (!q || (dq ? r.date.slice(5) === dq.md && (!dq.y || r.date.startsWith(dq.y))
                 : `${r.code} ${r.name} ${r.title}`.toLowerCase().includes(q)))));
  }

  function pctCell(r) {
    if (r.pct == null) return '<td class="c-pct down">–</td>';
    if (r.up) return `<td class="c-pct up">▲${r.pct}%</td>`;
    return `<td class="c-pct down">${r.pct === 50 ? '' : '▼'}${r.pct}%</td>`;
  }

  function pdfLinks(r) {
    return (r.pdfs || [{ label: 'PDF', url: r.url }]).map(p =>
      `<a class="pdf${p.label === '短信' || p.label === '修正' ? '' : ' sub'}" href="${esc(p.url)}" target="_blank" rel="noopener" title="${esc(p.title || r.title)}">${esc(p.label)}</a>`).join('');
  }

  const num = v => v == null ? '<td>–</td>' : `<td class="${v < 0 ? 'neg' : ''}">${v.toLocaleString('ja-JP')}</td>`;
  const pct = v => v == null ? '<td>–</td>' : `<td class="${v < 0 ? 'neg' : ''}">${v.toFixed(1)}%</td>`;

  function finTables(f) {
    if (!f) return '';
    let h = '';
    if (f.quarters && f.quarters.length) {
      h += `<div class="fincap">四半期業績(単独・百万円)</div><div class="finbox"><table class="fin">
        <tr><th>決算期</th><th>売上高</th><th>営業益</th><th>経常益</th><th>最終益</th><th>営業率</th></tr>`
        + f.quarters.map((q, i) => `<tr class="${i === f.quarters.length - 1 ? 'cur' : ''}"><td>${esc(q.label)}</td>`
          + num(q.sales) + num(q.op) + num(q.ordinary) + num(q.net) + pct(q.margin) + '</tr>').join('')
        + '</table></div>';
    }
    if (f.plan) {
      const p = f.plan, heads = ['1Q', '2Q', '3Q', '通期'];
      h += `<div class="fincap">【今期の累計と${esc(p.fc_label)}】(各Q累計・百万円)<span>今期=${esc(p.fy)}</span></div>
        <div class="finbox"><table class="fin"><tr><th></th>${heads.map((x, i) => `<th>${i + 1 <= p.n_q ? '' : '('}${x}${i + 1 <= p.n_q ? '' : ')'}</th>`).join('')}
        <th>${esc(p.fc_label)}</th><th>進捗率</th></tr>`
        + p.rows.map(r => `<tr><td class="lab">${esc(r[0])}</td>` + r.slice(1, 6).map(num).join('') + pct(r[6]) + '</tr>').join('')
        + '</table></div>';
    }
    return h;
  }

  function detail(r) {
    const items = (r.details || []).map(([k, v, t]) => `<div><span>${esc(k)}</span><span class="${esc(t)}">${esc(v)}</span></div>`).join('');
    return `<tr class="detail"><td colspan="7">
      <div class="dtitle">${esc(r.title)}</div>
      <div class="dlinks">${(r.pdfs || []).map(p => `<a href="${esc(p.url)}" target="_blank" rel="noopener" title="${esc(p.title || '')}">${esc(p.label === '資料' || p.label === '資料2' ? '説明資料' : p.label === '短信' ? '決算短信' : '修正の開示')}(PDF)</a>`).join('')}</div>
      ${finTables(r.fin)}${items ? `<div class="dl">${items}</div>` : ''}
    </td></tr>`;
  }

  function render() {
    const rows = visible();
    const total = (index.days || []).reduce((s, x) => s + x.n, 0) || allRows().length;
    $('count').textContent = `${rows.length}件 / 決算・修正 ${total}件`;
    const byTime = true;
    let html = '', day = null;
    rows.forEach((r, i) => {
      if (byTime && r.date !== day) {
        const c = (index.days || []).find(x => x.date === r.date);
        html += `<tr class="dayrow"><td colspan="7"><span class="dd">${r.date.replace(/-/g, '/')}(${wd(r.date)})</span>`
              + (c ? `<span class="dn">決算 ${c.earn}件 ・ 修正 ${c.rev}件</span>` : '') + '</td></tr>';
        day = r.date;
      }
      const isNew = fresh.has(r.id);
      html += `<tr class="row${i % 2 ? ' alt' : ''}${r.up ? ' up' : ''}${isNew ? ' new' : ''}" data-id="${esc(r.id)}">
        <td class="c-date">${r.date.slice(5).replace('-', '/')}</td><td class="c-time">T${esc(r.time)}</td>
        <td class="c-code">${esc(r.code)}</td>
        <td class="c-name" title="${esc(r.title)}">${esc(r.name)}${isNew ? '<span class="badge-new">NEW</span>' : ''}</td>
        <td class="c-kind"><a class="pdf" href="${esc(r.url)}" target="_blank" rel="noopener" title="${esc(r.title)}">${esc(r.group)}</a></td><td class="c-per">${esc(r.period)}</td>${pctCell(r)}</tr>`;
      if (open.has(r.id)) html += detail(r);
    });
    $('tb').innerHTML = html || `<tr><td colspan="7" class="more">${state.onlyNew ? '新着はありません' : '該当する開示はありません'}</td></tr>`;

    const nd = state.day ? null : nextDate();
    $('more').innerHTML = state.day ? '' : nd
      ? `${loading ? '読み込み中…' : `スクロールで ${+nd.slice(5, 7)}/${+nd.slice(8, 10)} 以前を表示`}<br><button id="moreBtn">さらに表示</button>`
      : (index.dates.length ? `${index.dates[index.dates.length - 1].replace(/-/g, '/')} 以降をすべて表示しています` : '');
  }

  async function loadMore(n = 1) {
    if (loading) return;
    loading = true; render();
    try {
      for (let i = 0; i < n; i++) { const d = nextDate(); if (!d) break; await loadDay(d); }
    } catch (e) { setStatus(true); }
    loading = false; render();
  }

  async function loadAll() { while (nextDate()) { await loadMore(3); } }

  async function refresh(manual) {
    if (document.hidden && !manual) return;              // 非表示の間は休止
    try {
      const idx = await fetchJSON('data/index.json');
      // 画面の作りが更新されていたら新しい版に読み直す(URLを変えてブラウザのキャッシュを避ける)
      if (idx.build && index.build && idx.build !== index.build) {
        location.replace(location.pathname + '?v=' + idx.build + location.hash);
        return;
      }
      const changed = idx.generated_at !== index.generated_at;
      index = idx;
      if (changed || manual) {
        // 最新日だけ取り直す(過去の日は変わらない)
        const latest = index.dates[0];
        if (latest) { await loadDay(latest); markFresh(days[latest]); }
      }
      setStatus(false);
      render();
    } catch (e) { setStatus(true); }
  }


  async function setDay(d) {
    state.day = d || '';
    $('dayq').value = state.day;
    $('dayclr').hidden = !state.day;
    open.clear();
    if (state.day && index.dates.includes(state.day) && !days[state.day]) {
      render();
      try { await loadDay(state.day); } catch (e) { setStatus(true); }
    }
    render();
    if (!state.day) autoMore();
  }
  $('dayq').addEventListener('change', e => setDay(e.target.value));
  $('dayclr').addEventListener('click', () => setDay(''));

  let qTimer = null;
  $('q').addEventListener('input', e => {
    state.q = e.target.value; render();
    clearTimeout(qTimer);
    if (state.q.trim()) qTimer = setTimeout(loadAll, 300);     // 検索は全期間を対象にする
  });
  $('onlyNew').addEventListener('change', e => { state.onlyNew = e.target.checked; render(); });
  $('reload').addEventListener('click', () => refresh(true));
  $('more').addEventListener('click', e => { if (e.target.id === 'moreBtn') loadMore(); });
  $('tb').addEventListener('click', e => {
    if (e.target.closest('a')) return;
    const tr = e.target.closest('tr.row'); if (!tr) return;
    const id = tr.dataset.id;
    open.has(id) ? open.delete(id) : open.add(id);
    fresh.delete(id);
    render();
  });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  setInterval(refresh, 60000);                         // 1分ごとに確認(非表示の間は休止)

  // 一番下に近づいたら前の日を読み足す(無限スクロール)
  const nearBottom = () => $('more').getBoundingClientRect().top < innerHeight + 600;
  async function autoMore() {
    while (!loading && !state.day && nextDate() && nearBottom()) await loadMore();
  }
  let scrollTimer = null;
  addEventListener('scroll', () => { clearTimeout(scrollTimer); scrollTimer = setTimeout(autoMore, 100); }, { passive: true });
  addEventListener('resize', () => autoMore());

  if (d0.date) markFresh(d0.rows);
  setStatus(false);
  render();
  loadMore(2).then(autoMore);                          // 最初は直近3日ぶんを用意
})();
</script>
</body>
</html>
