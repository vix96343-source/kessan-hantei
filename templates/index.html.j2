{% extends "_base.html.j2" %}
{% set page = "index" %}
{% block title %}決算予定{% endblock %}
{% block sub %}JPX決算発表予定日 {{ calendar_updated | replace("T", " ") }} 取得 ・ ページ生成 {{ generated_at }}{% endblock %}
{% block style %}
.cal .row { grid-template-columns: 210px 92px 70px 150px 1fr; }
.mk { font-size: 12px; color: var(--muted); }
.num { font-variant-numeric: tabular-nums; text-align: right; color: var(--muted); }
.timing.warn { color: var(--warn); font-weight: 650; }
.timing { font-size: 12px; color: var(--muted); white-space: nowrap; }
.rev { font-size: 13px; }
.note { background: var(--warn-soft); color: var(--warn); border-radius: 10px; padding: 10px 12px; margin-bottom: 12px; font-size: 13px; }
label.chk { display: inline-flex; gap: 6px; align-items: center; color: var(--muted); font-size: 13px; cursor: pointer; }
@media (max-width: 760px) {
  .cal .row { grid-template-columns: 1fr auto; grid-template-areas: "co num" "meta meta" "rev rev"; row-gap: 2px; }
  .cal .co { grid-area: co; } .cal .num { grid-area: num; }
  .cal .meta { grid-area: meta; } .cal .rev { grid-area: rev; }
  .cal .row > .timing, .cal .row > .mkcol { display: none; }
}
@media (min-width: 761px) { .cal .meta { display: none; } }
{% endblock %}
{% block content %}
  {% if not has_universe %}
  <div class="note">銘柄一覧(universe.csv)がまだ無いため表示できません。<code>python -m src.cli universe</code> を実行してください。</div>
  {% endif %}
  <section class="tiles" aria-label="サマリ">
    <div class="tile"><div class="k">翌営業日 <span id="nbd"></span></div><div class="v" id="tNext">–</div></div>
    <div class="tile"><div class="k">5営業日合計</div><div class="v" id="tAll">–</div></div>
    <div class="tile up"><div class="k">90日内に上方修正</div><div class="v" id="tUp">–</div></div>
    <div class="tile down"><div class="k">90日内に下方修正</div><div class="v" id="tDown">–</div></div>
  </section>

  <div class="controls">
    <div class="seg" id="dateSeg" role="group" aria-label="発表日"></div>
    <div class="seg" id="mktSeg" role="group" aria-label="市場">
      <button data-v="all">全市場</button>
      <button data-v="プライム">プライム</button>
      <button data-v="スタンダード">スタンダード</button>
    </div>
    <label class="chk"><input type="checkbox" id="liq"> 売買代金 {{ min_turnover_oku | round(1) }}億円/日 以上</label>
    <input type="search" id="q" placeholder="コード・会社名・業種で検索" aria-label="検索">
    <span class="count" id="count"></span>
  </div>

  <div id="out" class="cal"></div>
{% endblock %}
{% block footer %}出典: 決算発表予定日・上場銘柄一覧は日本取引所グループ、売買代金は Yahoo Finance(20日平均、終値×出来高の近似)、修正は TDnet。発表時刻は未確定のものを「引け後(予定)」と表示。投資判断は自己責任で。{% endblock %}
{% block script %}
<script id="data" type="application/json">{{ data_json | safe }}</script>
<script>
const ROWS = JSON.parse(document.getElementById('data').textContent);
const NEXT = '{{ next_bd }}';
const MIN_OKU = {{ min_turnover_oku }};
const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
const wd = d => '日月火水木金土'[new Date(d + 'T00:00:00').getDay()];
const md = d => `${+d.slice(5, 7)}/${+d.slice(8, 10)}`;

const state = { date: 'all', mkt: 'all', liq: true, q: '' };
try { Object.assign(state, JSON.parse(localStorage.getItem('cal-filter') || '{}'), { q: '' }); } catch (e) {}
const save = () => { try { localStorage.setItem('cal-filter', JSON.stringify({ mkt: state.mkt, liq: state.liq })); } catch (e) {} };

const dates = [...new Set(ROWS.map(r => r.date))].sort();
const dateSeg = document.getElementById('dateSeg');
dateSeg.innerHTML = '<button data-v="all">全日</button>' + dates.map(d => `<button data-v="${d}">${md(d)}(${wd(d)})</button>`).join('');
if (state.date !== 'all' && !dates.includes(state.date)) state.date = 'all';

function base() {
  return ROWS.filter(r => (state.mkt === 'all' || r.market === state.mkt) &&
    (!state.liq || (r.turnover_oku ?? 0) >= MIN_OKU));
}

function revCell(r) {
  if (r.rev_dir === 'up' || r.rev_dir === 'down') {
    const pct = r.rev_pct != null ? ` ${Math.abs(r.rev_pct).toFixed(1)}%` : '';
    return `<span class="dir ${r.rev_dir}">${r.rev_dir === 'up' ? '▲上方' : '▼下方'}${pct}</span> <span class="mk">${md(r.rev_date)} 修正済み</span>`;
  }
  if (r.rev_date) return `<span class="mk">${md(r.rev_date)} 修正あり(方向不明)</span>`;
  return '<span class="mk">直近の修正なし</span>';
}

function timingCell(r) {
  if (r.timing === '場中') return `<span class="timing warn">⚠ 場中 ${esc(r.time)}</span>`;
  return `<span class="timing">${r.confirmed ? '引け後 ' + esc(r.time) : '引け後(予定)'}</span>`;
}

function render() {
  const b = base();
  document.getElementById('nbd').textContent = `${md(NEXT)}(${wd(NEXT)})`;
  document.getElementById('tNext').textContent = b.filter(r => r.date === NEXT).length;
  document.getElementById('tAll').textContent = b.length;
  document.getElementById('tUp').textContent = b.filter(r => r.rev_dir === 'up').length;
  document.getElementById('tDown').textContent = b.filter(r => r.rev_dir === 'down').length;

  const q = state.q.trim().toLowerCase();
  const rows = b.filter(r => (state.date === 'all' || r.date === state.date) &&
    (!q || `${r.code} ${r.name} ${r.sector}`.toLowerCase().includes(q)))
    .sort((x, y) => x.date.localeCompare(y.date) || (y.turnover_oku ?? 0) - (x.turnover_oku ?? 0));
  document.getElementById('count').textContent = `${rows.length} 社`;
  if (!rows.length) { document.getElementById('out').innerHTML = '<div class="list"><div class="empty">該当する銘柄はありません</div></div>'; return; }

  let html = '', day = null;
  for (const r of rows) {
    if (r.date !== day) {
      if (day) html += '</div>';
      html += `<div class="day">${r.date.replace(/-/g, '/')}(${wd(r.date)})発表${r.date === NEXT ? ' ・ 翌営業日' : ''}</div><div class="list">`;
      day = r.date;
    }
    const oku = r.turnover_oku != null ? `${r.turnover_oku.toFixed(1)}億` : '–';
    html += `<div class="row">
      <span class="co"><a href="https://kabutan.jp/stock/?code=${encodeURIComponent(r.code)}" target="_blank" rel="noopener"><span class="code">${esc(r.code)}</span><span class="name">${esc(r.name)}</span></a></span>
      <span class="mkcol mk">${esc(r.market)} ・ ${esc(r.fq)}</span>
      <span class="num">${oku}</span>
      ${timingCell(r)}
      <span class="meta mk">${esc(r.market)} ・ ${esc(r.fq)} ・ ${esc(r.sector)} ・ ${r.timing === '場中' ? '⚠ 場中 ' + esc(r.time) : (r.confirmed ? '引け後 ' + esc(r.time) : '引け後(予定)')}</span>
      <span class="rev">${revCell(r)}</span>
    </div>`;
  }
  document.getElementById('out').innerHTML = html + '</div>';
}

function bindSeg(id, key) {
  const seg = document.getElementById(id);
  const sync = () => seg.querySelectorAll('button').forEach(b => b.setAttribute('aria-pressed', b.dataset.v === state[key]));
  seg.addEventListener('click', e => {
    const b = e.target.closest('button'); if (!b) return;
    state[key] = b.dataset.v; sync(); save(); render();
  });
  sync();
}
bindSeg('dateSeg', 'date'); bindSeg('mktSeg', 'mkt');
const liq = document.getElementById('liq');
liq.checked = state.liq;
liq.addEventListener('change', () => { state.liq = liq.checked; save(); render(); });
document.getElementById('q').addEventListener('input', e => { state.q = e.target.value; render(); });
render();
</script>
{% endblock %}
