<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ "適時開示" if page == "feed" else "決算予定" }} | 決算持ち越し判定君</title>
<style>
:root {
  --bg: #05080b; --line: #1a2128; --head: #b9c2cc; --text: #e9eef2; --muted: #7f8a95;
  --green: #2bea7f; --tab: #12202b;
}
* { box-sizing: border-box; }
body {
  margin: 0; background: var(--bg); color: var(--text);
  font: 600 16px/1.4 "Meiryo UI", "Yu Gothic UI", "Hiragino Sans", system-ui, sans-serif;
}
nav { display: flex; gap: 4px; padding: 10px 12px 0; max-width: 760px; margin: 0 auto; }
nav a { color: var(--muted); text-decoration: none; padding: 6px 14px; border-radius: 6px 6px 0 0; font-size: 14px; }
nav a[aria-current="page"] { color: var(--text); background: var(--tab); }
main { max-width: 760px; margin: 0 auto; }
table { width: 100%; border-collapse: collapse; table-layout: fixed; font-variant-numeric: tabular-nums; }
th {
  position: sticky; top: 0; background: var(--bg); color: var(--head); font-weight: 600;
  padding: 8px 6px; border-bottom: 1px solid var(--line); font-size: 15px; z-index: 1;
}
td { padding: 9px 6px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; border-bottom: 1px solid var(--line); }
td a { color: inherit; text-decoration: none; }
.c-time { width: 76px; } .c-code { width: 60px; } .c-kind { width: 104px; } .c-pct { width: 72px; text-align: right; }
th.c-pct { text-align: right; }
tr.up td { color: var(--green); font-weight: 700; }
tr.day td { color: var(--muted); font-size: 13px; padding: 12px 6px 4px; border-bottom: 0; }
.warn { color: #ffb84d; }
.none { color: var(--muted); font-weight: 400; }
footer { color: var(--muted); font: 400 12px/1.6 system-ui, sans-serif; padding: 18px 12px 40px; max-width: 760px; margin: 0 auto; }
@media (max-width: 480px) {
  body { font-size: 13px; }
  th { font-size: 12px; }
  .c-time { width: 62px; } .c-code { width: 44px; } .c-kind { width: 70px; } .c-pct { width: 56px; }
  td, th { padding-left: 3px; padding-right: 3px; }
}
</style>
</head>
<body>
<nav>
  <a href="index.html"{% if page == "feed" %} aria-current="page"{% endif %}>適時開示</a>
  <a href="calendar.html"{% if page == "calendar" %} aria-current="page"{% endif %}>決算予定</a>
</nav>
<main>
<table>
  <colgroup><col class="c-time"><col class="c-code"><col><col class="c-kind"><col class="c-pct"></colgroup>
  <thead><tr>
    <th class="c-time">{{ "時刻" if page == "feed" else "発表" }}</th><th class="c-code">コード</th><th>企業名</th>
    <th class="c-kind">種別</th><th class="c-pct">上昇確度</th>
  </tr></thead>
  <tbody>
  {% for d, rows in groups %}
    <tr class="day"><td colspan="5">{{ d | dlabel }}</td></tr>
    {% for r in rows %}
    <tr class="{{ 'up' if r.up }}">
      {% if page == "feed" %}
      <td>T{{ r.time }}</td>
      {% else %}
      <td class="{{ 'warn' if r.intraday }}">{{ ("⚠" ~ r.time) if r.intraday else r.time }}</td>
      {% endif %}
      <td><a href="https://kabutan.jp/stock/?code={{ r.code }}" target="_blank" rel="noopener">{{ r.code }}</a></td>
      <td>{% if r.url %}<a href="{{ r.url }}" target="_blank" rel="noopener" title="{{ r.title }}">{{ r.name }}</a>{% else %}{{ r.name }}{% endif %}</td>
      <td>{{ r.kind }}</td>
      <td class="c-pct">{% if r.pct is none %}<span class="none">–</span>{% elif r.up %}▲{{ r.pct }}%{% else %}▼{{ r.pct }}%{% endif %}</td>
    </tr>
    {% endfor %}
  {% else %}
    <tr><td colspan="5" class="none">データがありません</td></tr>
  {% endfor %}
  </tbody>
</table>
</main>
<footer>
  {{ generated_at }} 更新 ・ 出典: TDnet / JPX / Yahoo Finance<br>
  上昇確度は暫定値(同種の開示が過去に「開示前終値→開示後最初の終値」で上昇した割合)。判定基準を受け取り次第置き換えます。
</footer>
</body>
</html>
